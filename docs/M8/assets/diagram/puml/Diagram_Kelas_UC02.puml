@startuml
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #222222
skinparam arrowColor #222222
skinparam packageBorderColor #888888
skinparam defaultFontName Arial
skinparam classFontStyle bold
skinparam stereotypeFontSize 10
hide circle
hide stereotype


class "HalamanOtentikasi" as C01 {
  - nama: String
  - nim: String
  - email: String
  - kataSandi: String
  - setujuKebijakan: Boolean
  - kodeVerifikasi: String
  - sisaWaktu: Integer
  - token: String
  + tampilkanFormulirVerifikasi(): void
  + kirimKodeVerifikasi(email: String, kode: String): void
  + mintaKirimUlang(email: String): void
  + resetHitungMundur(): void
  + tampilkanPesanSukses(pesan: String): void
  + arahkanKeBeranda(): void
  + tampilkanPesanGalat(pesan: String): void
}
class "AkunController" as C13 {
  + buatKodeVerifikasi(idAkun: String): String
  + verifikasiAkun(email: String, kode: String): Boolean
  + validasiKodeVerifikasi(kode: String): Boolean
  + cekKedaluwarsaKode(idToken: String): Boolean
  + hanguskanKodeLama(idAkun: String): void
  + kirimUlangKode(email: String): Boolean
}
class "NotifikasiController" as C19 {
  + kirimEmailVerifikasi(email: String, kode: String): Boolean
}
class "Akun" as C23 {
  - idAkun: String
  - nama: String
  - nim: String
  - email: String
  - kataSandiHash: String
  - statusAkun: String
  - statusBlokir: Boolean
  - peran: String
  - setujuKebijakan: Boolean
  - waktuDaftar: DateTime
  + cariByEmail(email: String): Akun
  + perbaruiStatusAkun(status: String): Boolean
}
class "TokenVerifikasi" as C27 {
  - idToken: String
  - idAkun: String
  - kode: String
  - waktuBuat: DateTime
  - waktuKedaluwarsa: DateTime
  - statusPakai: String
  + simpan(idAkun: String, kode: String, waktuBuat: DateTime, waktuKedaluwarsa: DateTime, statusPakai: String): Boolean
  + cariTokenAktif(idAkun: String): TokenVerifikasi
  + cocokkanKode(kodeInput: String): Boolean
  + sudahKedaluwarsa(): Boolean
  + tandaiTerpakai(): void
  + tandaiHangus(): void
}
class "Notifikasi" as C35 {
  - idNotifikasi: String
  - idAkun: String
  - jenis: String
  - isi: String
  - waktuKirim: DateTime
  - statusBaca: Boolean
  + simpan(idAkun: String, jenis: String, isi: String, waktuKirim: DateTime, statusBaca: Boolean): Boolean
}
class "SurelAdapter" as C43 {
  - hostSmtp: String
  - portSmtp: Integer
  - alamatPengirim: String
  + kirimSurel(tujuan: String, subjek: String, isi: String): Boolean
}
C01 --> C13
C13 ..> C23
C13 ..> C27
C13 ..> C19
C19 ..> C35
C19 ..> C43
C23 "1" -- "0..*" C27
C23 "1" -- "0..*" C35
@enduml
