@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center
skinparam backgroundColor #FFFFFF
skinparam responseMessageBelowArrow true
title UC01 — Normal
actor "Calon Pengguna" as User
boundary ":HalamanOtentikasi" as UIo
control ":AkunController" as AC
control ":Kriptografi" as Kr
control ":NotifikasiController" as NC
entity ":DokumenLegal" as Dok
entity ":Akun" as Akun
entity ":TokenVerifikasi" as Tok
entity ":Notifikasi" as Notif
participant ":SurelAdapter" as Surel
User -> UIo: tampilkanFormulirPendaftaran()
UIo -> AC: getTautanDokumenLegal()
AC -> Dok: getTautan()
Dok --> AC: tautanDokumen
AC --> UIo: tautanDokumen
UIo -> UIo: tampilkanKebijakanPrivasi(tautanDokumen)
User -> UIo: kirimFormulirPendaftaran(nama, nim, email, kataSandi, setujuKebijakan)
UIo -> AC: daftarAkun(nama, nim, email, kataSandi, setujuKebijakan)
AC -> AC: validasiKelengkapanFormulir(nama, nim, email, kataSandi, setujuKebijakan)
AC -> AC: validasiDomainEmail(email)
AC -> AC: cekKeunikanEmail(email)
AC -> Akun: cariByEmail(email)
Akun --> AC: null (surel belum terdaftar)
AC -> AC: hashKataSandi(kataSandi)
AC -> Kr: hash(kataSandi)
Kr --> AC: kataSandiHash
AC -> Akun: simpan(nama, nim, email, kataSandiHash, "Belum Terverifikasi", true)
Akun --> AC: idAkun
AC -> AC: buatKodeVerifikasi(idAkun)
AC -> Tok: simpan(idAkun, kode, waktuBuat, waktuKedaluwarsa, "Aktif")
Tok --> AC: true
AC -> NC: kirimEmailVerifikasi(email, kode)
NC -> Notif: simpan(idAkun, "Surel Verifikasi", isi, waktuKirim, false)
Notif --> NC: true
NC -> Surel: kirimSurel(email, "Kode Verifikasi ITBELI", isi)
Surel --> NC: true
NC --> AC: true
AC --> UIo: true
UIo -> UIo: arahkanKeHalamanVerifikasi()
@enduml
