@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center
skinparam backgroundColor #FFFFFF
skinparam responseMessageBelowArrow true
title UC04 — Normal
actor "Pengguna" as User
boundary ":HalamanOtentikasi" as UIo
control ":AkunController" as AC
control ":Otorisasi" as Oto
entity ":SesiLogin" as Sesi
UIo -> UIo: tampilkanTombolKeluar()
User -> UIo: kirimPermintaanLogout(token)
UIo -> AC: logout(token)
AC -> Oto: verifikasiToken(token)
Oto -> Sesi: cariSesiAktif(token)
Sesi --> Oto: sesiLogin
Oto --> AC: sesiLogin
AC -> AC: cabutSesi(token)
AC -> Sesi: nonaktifkan(token)
AC --> UIo: true
UIo -> UIo: hapusTokenLokal()
UIo -> UIo: arahkanKeHalamanLogin()
@enduml
