@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center
skinparam backgroundColor #FFFFFF
skinparam responseMessageBelowArrow true
title UC03 — Alternatif 1: Kredensial Tidak Sesuai
actor "Pengguna" as User
boundary ":HalamanOtentikasi" as UIo
control ":AkunController" as AC
control ":Kriptografi" as Kr
entity ":Akun" as Akun
User -> UIo: kirimFormulirLogin(email, kataSandi)
UIo -> AC: login(email, kataSandi)
AC -> AC: cariAkunByEmail(email)
AC -> Akun: cariByEmail(email)
Akun --> AC: akun (idAkun, kataSandiHash, statusAkun, statusBlokir, peran)
AC -> AC: verifikasiKataSandi(kataSandi, kataSandiHash)
AC -> Kr: cocokkanHash(kataSandi, kataSandiHash)
Kr --> AC: false
note right of AC: Sesi tidak dibuat
AC --> UIo: galat kredensial
UIo -> UIo: tampilkanPesanGalat("Email atau kata sandi yang Anda masukkan salah.")
@enduml
