@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center
skinparam backgroundColor #FFFFFF
skinparam responseMessageBelowArrow true
title UC20 — Alternatif 1: Akses oleh Akun Bukan Admin
actor "Pengguna" as User
boundary ":DasborAdmin" as Dash
control ":ModerasiController" as MC
control ":Otorisasi" as Oto
entity ":SesiLogin" as Sesi
entity ":Admin" as Adm
User -> Dash: bukaDaftarLaporan()
Dash -> MC: getAllLaporan(token)
MC -> MC: otorisasiAdmin(token)
MC -> Oto: verifikasiAdmin(token)
Oto -> Sesi: cariSesiAktif(token)
Sesi --> Oto: sesiLogin
Oto -> Sesi: getIdAkun()
Sesi --> Oto: idAkun
Oto -> Adm: verifikasiPeran(idAkun)
Adm --> Oto: false
Oto --> MC: akses ditolak
note right of MC: Fungsi moderasi ditolak untuk akun\nyang tidak berperan admin (KF56)
MC --> Dash: akses ditolak
Dash -> Dash: tampilkanAksesDitolak()
@enduml
