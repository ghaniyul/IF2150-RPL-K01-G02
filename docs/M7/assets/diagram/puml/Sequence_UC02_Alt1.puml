@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center
skinparam backgroundColor #FFFFFF
skinparam responseMessageBelowArrow true
title UC02 — Alternatif 1: Kode Tidak Valid / Kedaluwarsa
actor "Pengguna" as User
boundary ":HalamanOtentikasi" as UIo
control ":AkunController" as AC
entity ":Akun" as Akun
entity ":TokenVerifikasi" as Tok
User -> UIo: kirimKodeVerifikasi(email, kode)
UIo -> AC: verifikasiAkun(email, kode)
AC -> Akun: cariByEmail(email)
Akun --> AC: akun
AC -> Tok: cariTokenAktif(idAkun)
Tok --> AC: tokenVerifikasi
AC -> AC: validasiKodeVerifikasi(kode)
AC -> Tok: cocokkanKode(kode)
Tok --> AC: false / kode sudah kedaluwarsa
note right of AC: Status akun tidak diubah
AC --> UIo: false
UIo -> UIo: tampilkanPesanGalat("Kode tidak valid atau telah kedaluwarsa. Silakan minta kode baru.")
@enduml
