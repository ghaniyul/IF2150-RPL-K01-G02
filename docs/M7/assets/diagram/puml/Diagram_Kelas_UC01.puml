@startuml
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #222222
skinparam arrowColor #222222
skinparam packageBorderColor #888888
skinparam defaultFontName Arial
skinparam classFontStyle bold
skinparam stereotypeFontSize 10
hide circle
hide stereotype


class "HalamanOtentikasi" as C01 {
  - nama: String
  - nim: String
  - email: String
  - kataSandi: String
  - setujuKebijakan: Boolean
  - kodeVerifikasi: String
  - sisaWaktu: Integer
  - token: String
  + tampilkanFormulirPendaftaran(): void
  + tampilkanKebijakanPrivasi(tautan: String): void
  + kirimFormulirPendaftaran(nama: String, nim: String, email: String, kataSandi: String, setujuKebijakan: Boolean): void
  + arahkanKeHalamanVerifikasi(): void
  + tampilkanPesanGalat(pesan: String): void
}
class "AkunController" as C13 {
  + daftarAkun(nama: String, nim: String, email: String, kataSandi: String, setujuKebijakan: Boolean): Boolean
  + validasiKelengkapanFormulir(nama: String, nim: String, email: String, kataSandi: String, setujuKebijakan: Boolean): Boolean
  + validasiDomainEmail(email: String): Boolean
  + cekKeunikanEmail(email: String): Boolean
  + hashKataSandi(kataSandi: String): String
  + buatKodeVerifikasi(idAkun: String): String
  + getTautanDokumenLegal(): String
}
class "NotifikasiController" as C19 {
  + kirimEmailVerifikasi(email: String, kode: String): Boolean
}
class "Akun" as C23 {
  - idAkun: String
  - nama: String
  - nim: String
  - email: String
  - kataSandiHash: String
  - statusAkun: String
  - statusBlokir: Boolean
  - peran: String
  - setujuKebijakan: Boolean
  - waktuDaftar: DateTime
  + simpan(nama: String, nim: String, email: String, kataSandiHash: String, statusAkun: String, setujuKebijakan: Boolean): String
  + cariByEmail(email: String): Akun
}
class "TokenVerifikasi" as C27 {
  - idToken: String
  - idAkun: String
  - kode: String
  - waktuBuat: DateTime
  - waktuKedaluwarsa: DateTime
  - statusPakai: String
  + simpan(idAkun: String, kode: String, waktuBuat: DateTime, waktuKedaluwarsa: DateTime, statusPakai: String): Boolean
}
class "Notifikasi" as C35 {
  - idNotifikasi: String
  - idAkun: String
  - jenis: String
  - isi: String
  - waktuKirim: DateTime
  - statusBaca: Boolean
  + simpan(idAkun: String, jenis: String, isi: String, waktuKirim: DateTime, statusBaca: Boolean): Boolean
}
class "DokumenLegal" as C40 {
  - idDokumen: String
  - jenisDokumen: String
  - judul: String
  - isi: String
  - klausaPrivasiPesan: String
  - versi: String
  - tanggalBerlaku: Date
  - statusPublikasi: Boolean
  - tautan: String
  + getTautan(): String
}
class "Kriptografi" as C42 {
  - saltRounds: Integer
  - kunciEnkripsi: String
  + hash(teks: String): String
}
class "SurelAdapter" as C43 {
  - hostSmtp: String
  - portSmtp: Integer
  - alamatPengirim: String
  + kirimSurel(tujuan: String, subjek: String, isi: String): Boolean
}
C01 --> C13
C13 ..> C23
C13 ..> C27
C13 ..> C40
C13 ..> C19
C13 ..> C42
C19 ..> C35
C19 ..> C43
C23 "1" -- "0..*" C27
C23 "1" -- "0..*" C35
C23 "0..*" -- "1" C40
@enduml
