@startuml
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #222222
skinparam arrowColor #222222
skinparam packageBorderColor #888888
skinparam defaultFontName Arial
skinparam classFontStyle bold
skinparam stereotypeFontSize 10
hide circle
hide stereotype


class "HalamanKatalog" as C05 {
  - listProduk: List<Barang>
  - halamanAktif: Integer
  - total: Integer
  - kataKunci: String
  - filterAktif: Map<String, Any>
  - kriteriaUrutan: String
  + showKatalog(): void
  + tampilkanHasil(hasil: Map<String, Any>): void
  + pindahHalaman(halaman: Integer): void
  + gulirKeAtas(): void
  + tampilkanPagination(total: Integer, halaman: Integer): void
  + sembunyikanPagination(): void
  + tampilkanPesanKosong(kodePesan: String): void
}
class "KartuProduk" as C06 {
  - idBarang: String
  - judul: String
  - harga: Double
  - fotoUtama: String
  - status: String
  - namaKategori: String
  - namaLokasi: String
  + render(barang: Barang): void
  + onClickDetail(idBarang: String): void
}
class "KatalogController" as C15 {
  + getProduk(kataKunci: String, filterAktif: Map<String, Any>, kriteriaUrutan: String, halaman: Integer): Map<String, Any>
  + paginasi(halaman: Integer, batas: Integer): Integer
}
class "Akun" as C23 {
  - idAkun: String
  - nama: String
  - nim: String
  - email: String
  - kataSandiHash: String
  - statusAkun: String
  - statusBlokir: Boolean
  - peran: String
  - setujuKebijakan: Boolean
  - waktuDaftar: DateTime
  + getSyaratTidakDiblokir(): Map<String, Any>
}
class "Penjual" as C25 {
}
class "Barang" as C29 {
  - idBarang: String
  - idPenjual: String
  - judul: String
  - harga: Double
  - deskripsiKondisi: String
  - idKategori: String
  - idLokasi: String
  - status: String
  - waktuUnggah: DateTime
  - waktuUbah: DateTime
  + getKatalog(kriteria: Map<String, Any>, urutan: String, halaman: Integer, batas: Integer): Map<String, Any>
}
class "FotoBarang" as C30 {
  - idFoto: String
  - idBarang: String
  - namaBerkas: String
  - format: String
  - ukuran: Long
  - urutan: Integer
  - pathBerkas: String
  + getFotoUtama(idBarang: String): String
}
C05 --> C15
C05 "1" *-- "0..20" C06
C15 ..> C29
C29 ..> C23
C23 <|-- C25
C25 "1" *-- "0..*" C29
C29 "1" *-- "1..5" C30
@enduml
