@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center
skinparam backgroundColor #FFFFFF

skinparam participant {
    BackgroundColor #FFFFFF
    BorderColor #000000
}
skinparam actor {
    BackgroundColor #FFFFFF
    BorderColor #000000
}
skinparam sequence {
    LifeLineBackgroundColor #FFFFFF
    LifeLineBorderColor #000000
    ArrowColor #000000
    ActorBorderColor #000000
    ActorBackgroundColor #FFFFFF
    GroupBorderColor #000000
    GroupBackgroundColor #FFFFFF
}

actor "Pengguna" as User
boundary ":HalamanOtentikasi" as UI
control ":AkunController" as Ctrl
entity ":Akun" as Akun
entity ":SesiLogin" as Sesi

User -> UI: kirimFormulirLogin(email, kataSandi)
activate UI
UI -> Ctrl: login(email, kataSandi)
activate Ctrl
Ctrl -> Ctrl: cariAkunByEmail(email)
Ctrl -> Akun: cariByEmail(email)
activate Akun
Akun --> Ctrl: dataAkun(idAkun, kataSandiHash, statusAkun, statusBlokir, peran)
deactivate Akun

Ctrl -> Ctrl: verifikasiKataSandi(kataSandi, kataSandiHash)
Ctrl -> Ctrl: cekStatusAkun(idAkun)
Ctrl -> Akun: getStatusAkun()
activate Akun
Akun --> Ctrl: "Terverifikasi" (tidak diblokir)
deactivate Akun

Ctrl -> Sesi: buatToken(idAkun)
activate Sesi
Sesi -> Sesi: simpan(idSesi, idAkun, token, waktuMulai, waktuKedaluwarsa, statusAktif=true)
Sesi --> Ctrl: tokenSesi
deactivate Sesi

Ctrl --> UI: loginBerhasil(tokenSesi, peran)
deactivate Ctrl
UI --> User: arahkanKeBeranda()
deactivate UI
@enduml
