@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam classBorderColor #000000
skinparam classBackgroundColor #FFFFFF
skinparam arrowColor #000000
skinparam nodesep 55
skinparam ranksep 55

hide circle
hide stereotype

class "FormulirBarang" as C04 {
  - judul: String
  - harga: Double
  - deskripsiKondisi: String
  - idKategori: String
  - idLokasi: String
  - daftarFoto: List<File>
  + tampilkanFormulir(): void
  + validasiTipeData(): Boolean
  + validasiFotoSisiKlien(): Boolean
  + tandaiIsianKosong(): void
  + kirimFormulir(data: Map<String, Any>): void
  + tampilkanNotifikasi(pesan: String): void
}

class "BarangController" as C14 {
  + buatBarang(token: String, data: Map<String, Any>, fotos: List<File>): Boolean
  + validasiKelengkapanIsian(data: Map<String, Any>): Boolean
  + validasiFoto(fotos: List<File>): Boolean
  + getIdPenjualDariSesi(token: String): String
  + simpanFoto(idBarang: String, fotos: List<File>): List<String>
  + terbitkanKeKatalog(idBarang: String): void
}

class "Penjual" as C25 {
  + buatListing(): void
}

class "SesiLogin" as C28 {
  - idSesi: String
  - idAkun: String
  - token: String
  + getIdAkun(): String
}

class "Barang" as C29 {
  - idBarang: String
  - idPenjual: String
  - judul: String
  - harga: Double
  - deskripsiKondisi: String
  - idKategori: String
  - idLokasi: String
  - status: String
  - waktuUnggah: DateTime
  + simpan(): Boolean
}

class "FotoBarang" as C30 {
  - idFoto: String
  - idBarang: String
  - namaBerkas: String
  - format: String
  - ukuran: Long
  - urutan: Integer
  - pathBerkas: String
  + validasiFormat(format: String): Boolean
  + validasiUkuran(ukuran: Long): Boolean
  + simpan(): Boolean
}

class "Kategori" as C31 {
  - idKategori: String
  - namaKategori: String
  + getDaftarKategori(): List<Kategori>
  + validasiKategori(idKategori: String): Boolean
}

class "LokasiCOD" as C32 {
  - idLokasi: String
  - namaLokasi: String
  - kampus: String
  + getDaftarLokasi(): List<LokasiCOD>
}

C04 --> C14
C14 ..> C25
C14 ..> C28
C14 ..> C29
C14 ..> C30
C14 ..> C31
C14 ..> C32

C25 "1" *-- "0..*" C29
C29 "1" *-- "1..5" C30
C31 "1" -- "0..*" C29
C32 "1" -- "0..*" C29
@enduml
