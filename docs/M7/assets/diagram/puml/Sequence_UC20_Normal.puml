@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center
skinparam backgroundColor #FFFFFF
skinparam responseMessageBelowArrow true
title UC20 — Normal
actor "Admin" as User
boundary ":DasborAdmin" as Dash
control ":ModerasiController" as MC
control ":Otorisasi" as Oto
entity ":SesiLogin" as Sesi
entity ":Admin" as Adm
entity ":Laporan" as Lap
User -> Dash: bukaDaftarLaporan()
Dash -> MC: getAllLaporan(token)
MC -> MC: otorisasiAdmin(token)
MC -> Oto: verifikasiAdmin(token)
Oto -> Sesi: cariSesiAktif(token)
Sesi --> Oto: sesiLogin
Oto -> Sesi: getIdAkun()
Sesi --> Oto: idAkun
Oto -> Adm: verifikasiPeran(idAkun)
Adm --> Oto: true
Oto --> MC: sesiLogin
MC -> Sesi: getIdAkun()
Sesi --> MC: idAdmin
MC -> Lap: getAllLaporan()
Lap --> MC: daftarLaporan
MC --> Dash: daftarLaporan
Dash -> Dash: tampilkanDaftarLaporan(daftarLaporan)
User -> Dash: filterLaporan("Baru")
Dash -> MC: filterByStatus(token, "Baru")
MC -> MC: otorisasiAdmin(token)
note right of MC: Pemeriksaan sesi dan peran sama\nseperti pada langkah sebelumnya
MC -> Lap: filterByStatus("Baru")
Lap --> MC: laporanBerstatusBaru
MC --> Dash: laporanBerstatusBaru
Dash -> Dash: tampilkanDaftarLaporan(laporanBerstatusBaru)
@enduml
