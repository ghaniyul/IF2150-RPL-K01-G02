@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center
skinparam backgroundColor #FFFFFF

skinparam participant {
    BackgroundColor #FFFFFF
    BorderColor #000000
}
skinparam actor {
    BackgroundColor #FFFFFF
    BorderColor #000000
}
skinparam sequence {
    LifeLineBackgroundColor #FFFFFF
    LifeLineBorderColor #000000
    ArrowColor #000000
    ActorBorderColor #000000
    ActorBackgroundColor #FFFFFF
    GroupBorderColor #000000
    GroupBackgroundColor #FFFFFF
}

actor "Pengguna" as User
boundary ":HalamanOtentikasi" as UI
control ":AkunController" as Ctrl
entity ":TokenVerifikasi" as Token
entity ":Akun" as Akun

User -> UI: kirimKodeVerifikasi(email, kode)
activate UI
UI -> Ctrl: verifikasiAkun(email, kode)
activate Ctrl
Ctrl -> Ctrl: validasiKodeVerifikasi(kode)
Ctrl -> Token: cocokkanKode(kode)
activate Token
Token --> Ctrl: kodeCocok (true)
deactivate Token
Ctrl -> Token: sudahKedaluwarsa()
activate Token
Token --> Ctrl: false
deactivate Token
Ctrl -> Token: tandaiTerpakai()
activate Token
Token --> Ctrl: statusTerpakai
deactivate Token
Ctrl -> Akun: perbaruiStatusAkun("Terverifikasi")
activate Akun
Akun --> Ctrl: statusBerhasil
deactivate Akun
Ctrl --> UI: verifikasiBerhasil
deactivate Ctrl
UI --> User: arahkanKeBeranda()
deactivate UI
@enduml
