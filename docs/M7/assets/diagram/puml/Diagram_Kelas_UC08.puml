@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam classBorderColor #000000
skinparam classBackgroundColor #FFFFFF
skinparam arrowColor #000000
skinparam nodesep 55
skinparam ranksep 55

hide circle
hide stereotype

class "HalamanListingPenjual" as C03 {
  - daftarTersedia: List<Barang>
  - daftarTerjual: List<Barang>
  - tabAktif: String
  + tampilkanDaftarListing(tersedia: List<Barang>, terjual: List<Barang>): void
  + pilihTab(namaTab: String): void
}

class "KartuProduk" as C06 {
  - idBarang: String
  - judul: String
  - harga: Double
  - fotoUtama: String
  - status: String
  + render(): void
}

class "BarangController" as C14 {
  + getListingSaya(token: String): Map<String, List<Barang>>
  + getIdPenjualDariSesi(token: String): String
  + kelompokkanBerdasarkanStatus(barangs: List<Barang>): Map<String, List<Barang>>
}

class "Penjual" as C25 {
  + lihatDaftarListingSendiri(): void
}

class "SesiLogin" as C28 {
  - idSesi: String
  - idAkun: String
  - token: String
  + getIdAkun(): String
}

class "Barang" as C29 {
  - idBarang: String
  - idPenjual: String
  - judul: String
  - harga: Double
  - status: String
  + getByPemilik(idPenjual: String): List<Barang>
}

C03 "1" *-- "0..*" C06
C03 --> C14
C14 ..> C25
C14 ..> C28
C14 ..> C29

C25 "1" *-- "0..*" C29
@enduml
