@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam classBorderColor #000000
skinparam classBackgroundColor #FFFFFF
skinparam arrowColor #000000
skinparam nodesep 55
skinparam ranksep 55

hide circle
hide stereotype

class "HalamanProfil" as C02 {
  - dataAkun: Akun
  - daftarKartuProduk: List<KartuProduk>
  + tampilkanProfil(data: Akun): void
  + tampilkanDaftarListing(daftarBarang: List<Barang>): void
  + bukaPengaturanAkun(): void
  + tampilkanTautanKebijakan(tautan: String): void
}

class "KartuProduk" as C06 {
  - idBarang: String
  - judul: String
  - harga: Double
  - fotoUtama: String
  - status: String
  + render(): void
}

class "AkunController" as C13 {
  + getProfil(token: String): Map<String, Any>
  + getIdAkunDariSesi(token: String): String
  + getDaftarBarangAkun(idAkun: String): List<Barang>
  + getTautanDokumenLegal(): String
}

class "Akun" as C23 {
  - idAkun: String
  - nama: String
  - nim: String
  - email: String
  + getDataIdentitas(): Map<String, String>
}

class "Pembeli" as C24 {
  + lihatProfil(): void
}

class "Penjual" as C25 {
  + lihatProfil(): void
}

class "SesiLogin" as C28 {
  - idSesi: String
  - idAkun: String
  - token: String
  + getIdAkun(): String
}

class "Barang" as C29 {
  - idBarang: String
  - idPenjual: String
  - judul: String
  - harga: Double
  - status: String
  + getByPemilik(idPenjual: String): List<Barang>
}

class "DokumenLegal" as C40 {
  - idDokumen: String
  - jenisDokumen: String
  - tautan: String
  + getTautan(): String
}

C02 "1" *-- "0..*" C06
C02 --> C13
C13 ..> C23
C13 ..> C28
C13 ..> C29
C13 ..> C40

C23 <|-- C24
C23 <|-- C25
C23 "1" -- "0..*" C28
C25 "1" *-- "0..*" C29
@enduml
