@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam classBorderColor #000000
skinparam classBackgroundColor #FFFFFF
skinparam arrowColor #000000
skinparam nodesep 55
skinparam ranksep 55

hide circle
hide stereotype

class "HalamanDokumenLegal" as C12 {
  - judul: String
  - isiDokumen: String
  + tampilkanDokumen(judul: String, isi: String): void
  + sorotKlausaPrivasi(klausa: String): void
}

class "DokumenLegalController" as C22 {
  + getDokumen(jenis: String): DokumenLegal
  + getKlausaPrivasi(): String
}

class "DokumenLegal" as C40 {
  - idDokumen: String
  - jenisDokumen: String
  - judul: String
  - isi: String
  - klausaPrivasiPesan: String
  - versi: String
  - tanggalBerlaku: Date
  - statusPublikasi: Boolean
  + getVersiTerbaru(): DokumenLegal
  + getIsi(): String
}

C12 --> C22
C22 ..> C40
@enduml
