@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center
skinparam backgroundColor #FFFFFF

skinparam participant {
    BackgroundColor #FFFFFF
    BorderColor #000000
}
skinparam actor {
    BackgroundColor #FFFFFF
    BorderColor #000000
}
skinparam sequence {
    LifeLineBackgroundColor #FFFFFF
    LifeLineBorderColor #000000
    ArrowColor #000000
    ActorBorderColor #000000
    ActorBackgroundColor #FFFFFF
    GroupBorderColor #000000
    GroupBackgroundColor #FFFFFF
}

actor "Pengguna" as User
boundary ":HalamanDokumenLegal" as UI
control ":DokumenLegalController" as Ctrl
entity ":DokumenLegal" as Dokumen

User -> UI: tampilkanDokumen()
activate UI
UI -> Ctrl: getDokumen("Kebijakan Privasi")
activate Ctrl
Ctrl -> Dokumen: getVersiTerbaru()
activate Dokumen
Dokumen --> Ctrl: dokumenAktif
deactivate Dokumen
Ctrl -> Dokumen: getIsi()
activate Dokumen
Dokumen --> Ctrl: isiDokumen
deactivate Dokumen
Ctrl -> Ctrl: getKlausaPrivasi()
Ctrl --> UI: dataDokumen(judul, isi, klausaPrivasi)
deactivate Ctrl
UI -> UI: sorotKlausaPrivasi()
UI --> User: tampilkanDokumenLengkap()
deactivate UI
@enduml
