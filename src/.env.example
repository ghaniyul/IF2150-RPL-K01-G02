# Salin berkas ini menjadi .env lalu isi nilainya. Jangan commit .env.

# Server
PORT=3000

# Basis data PostgreSQL (dipakai docker-compose.yml dan server)
DB_HOST=localhost
DB_PORT=5432
DB_USER=itbeli
DB_PASSWORD=
DB_NAME=itbeli
# Opsional: isi untuk memakai basis data lain (misalnya Supabase). Jika diisi, DB_* di atas diabaikan.
DATABASE_URL=

# Surel (SMTP). Bawaan diarahkan ke Mailpit dari docker-compose.yml,
# kotak masuknya dapat dilihat di http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SUREL_PENGIRIM=ITBELI <no-reply@itbeli.local>

# Keamanan
BCRYPT_SALT_ROUNDS=10
DURASI_SESI_JAM=24
DURASI_KODE_MENIT=15

# Kunci AES-256-GCM untuk isi pesan percakapan: 64 karakter hex (32 byte). Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KUNCI_ENKRIPSI_PESAN=

# Kunci VAPID untuk Web Push notifikasi pesan baru (KF34). Buat pasangan kunci dengan:
#   npx web-push generate-vapid-keys
# Kosongkan bila belum dipakai: notifikasi dalam aplikasi tetap jalan, hanya push yang dilewati.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontak pengelola untuk push service; bawaan mailto:admin@itbeli.local
VAPID_SUBJECT=

# Masuk dengan Google (akun ITB berdomain itb.ac.id). Kosongkan untuk menonaktifkan; tombolnya otomatis tersembunyi.
# Redirect URI yang didaftarkan di Google: <SSO_URL_DASAR>/api/akun/sso/google/kembali
# Google: Google Cloud Console → APIs & Services → Credentials → Create Credentials → OAuth client ID (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Alamat dasar aplikasi seperti yang dibuka browser (tanpa garis miring di akhir); dipakai untuk redirect_uri.
SSO_URL_DASAR=http://localhost:3000
# Kunci HMAC untuk cookie profil sementara pengguna SSO baru: 64 karakter hex. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KUNCI_SSO=

# Hanya untuk deploy ke Vercel: token Vercel Blob tempat foto listing dan bukti laporan disimpan.
# Kosongkan saat lokal; berkas disimpan di folder uploads/.
BLOB_READ_WRITE_TOKEN=
